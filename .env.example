# CineVerse Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.

# ─────────────────────────────────────────────
# Database (PostgreSQL recommended for production; SQLite for local dev)
# ─────────────────────────────────────────────
# Local SQLite (default for sandbox demo):
DATABASE_URL="file:./db/custom.db"

# Production PostgreSQL (Neon / Supabase / Render):
# DATABASE_URL="postgresql://user:password@host:5432/cineverse?schema=public"

# ─────────────────────────────────────────────
# TMDB API (primary movie data source)
# Get your free key at https://www.themoviedb.org/settings/api
# ─────────────────────────────────────────────
TMDB_API_KEY=""
TMDB_API_READ_TOKEN=""

# ─────────────────────────────────────────────
# OMDb API (optional — supplementary IMDb ratings & metadata)
# Get a free key at https://www.omdbapi.com/apikey.aspx
# ─────────────────────────────────────────────
OMDB_API_KEY=""

# ─────────────────────────────────────────────
# YouTube Data API v3 (optional — official trailers & video search)
# Get a key at https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────
YOUTUBE_API_KEY=""

# ─────────────────────────────────────────────
# Watchmode API (optional — streaming availability & provider info)
# Get a key at https://api.watchmode.com/
# ─────────────────────────────────────────────
WATCHMODE_API_KEY=""

# ─────────────────────────────────────────────
# Authentication (NextAuth.js)
# Generate a secret with: openssl rand -base64 32
# ─────────────────────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional — enable social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# Payment providers (subscriptions)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Mobile money (Rwanda — via approved provider like Flutterwave / DPO)
MOMO_API_KEY=""
MOMO_API_SECRET=""

# ─────────────────────────────────────────────
# Email (transactional)
# ─────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CineVerse <noreply@example.com>"

# ─────────────────────────────────────────────
# Redis (caching & queues — optional in production)
# ─────────────────────────────────────────────
REDIS_URL=""

# ─────────────────────────────────────────────
# Media storage (Cloudinary optional)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────────
# Analytics (optional)
# ─────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ─────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="CineVerse"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
