// CineVerse - Movie Discovery Platform
// Prisma schema (SQLite for sandbox demo)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  name          String?
  passwordHash  String
  avatarUrl     String?
  bio           String?
  role          String   @default("USER") // USER | MODERATOR | ADMIN | PREMIUM
  country       String?
  preferredLang String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  watchlists    Watchlist[]
  favorites     Favorite[]
  reviews       Review[]
  ratings       Rating[]
  collections   Collection[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  sessions      Session[]
  subscriptions Subscription[]
  payments      Payment[]
  userAchievements UserAchievement[]
  supportTickets SupportTicket[]
  viewingHistory ViewingHistory[]
  searchHistory SearchHistory[]
  discussionThreads DiscussionThread[]
  discussionReplies DiscussionReply[]
  threadLikes   ThreadLike[]
  replyLikes    ReplyLike[]
  passwordResets PasswordReset[]
  oauthAccounts OAuthAccount[]
  // Social graph (self-relation through Follow)
  followers     Follow[] @relation("Followee")
  following     Follow[] @relation("Follower")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    Int
  mediaType String   // MOVIE | TV
  status    String   @default("PENDING") // PENDING | WATCHING | COMPLETED | ABANDONED
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    Int
  mediaType String // MOVIE | TV | PERSON
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    Int
  mediaType String
  title     String
  content   String
  spoiler   Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tmdbId, mediaType])
  @@index([userId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    Int
  mediaType String
  score     Int // 1-10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([tmdbId, mediaType])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id          String   @id @default(cuid())
  collectionId String
  tmdbId      Int
  mediaType   String
  addedAt     DateTime @default(now())
  collection  Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // REVIEW_REPLY | NEW_FOLLOWER | SYSTEM | NEW_RELEASE
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model ApiCache {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  payload   String
  fetchedAt DateTime @default(now())
  ttlSec    Int      @default(3600)
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  plan            String   // FREE | PREMIUM_MONTHLY | PREMIUM_YEARLY
  status          String   @default("ACTIVE") // ACTIVE | CANCELED | EXPIRED | PAST_DUE
  startDate       DateTime @default(now())
  endDate         DateTime?
  autoRenew       Boolean  @default(true)
  paymentProvider String?  // STRIPE | PAYPAL | MOBILE_MONEY
  externalSubId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments        Payment[]

  @@index([userId])
}

model Payment {
  id              String   @id @default(cuid())
  subscriptionId  String
  userId          String
  amount          Float
  currency        String   @default("USD")
  provider        String   // STRIPE | PAYPAL | MOBILE_MONEY
  status          String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  externalPaymentId String?
  invoiceUrl      String?
  receiptUrl      String?
  description     String?
  createdAt       DateTime @default(now())
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   // PERCENT | FIXED
  value       Float
  validFrom   DateTime @default(now())
  validTo     DateTime?
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followeeId  String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee    User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  tier        String   @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String?
  subject     String
  category    String   @default("GENERAL") // GENERAL | BILLING | TECHNICAL | CONTENT | ABUSE
  priority    String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  message     String
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String?
  targetType  String   // REVIEW | COMMENT | USER | COLLECTION
  targetId    String
  reason      String
  status      String   @default("PENDING") // PENDING | REVIEWED | ACTIONED | DISMISSED
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String?
  query       String
  resultsCount Int     @default(0)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model ViewingHistory {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      Int
  mediaType   String
  watchedAt   DateTime @default(now())
  duration    Int?     // seconds watched
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tmdbId, mediaType])
}

model DiscussionCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  color       String   @default("#E50914")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  threads     DiscussionThread[]
}

model DiscussionThread {
  id          String   @id @default(cuid())
  categoryId  String
  userId      String
  title       String
  body        String
  views       Int      @default(0)
  pinned      Boolean  @default(false)
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    DiscussionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     DiscussionReply[]
  likes       ThreadLike[]

  @@index([categoryId])
  @@index([userId])
  @@index([createdAt])
}

model DiscussionReply {
  id          String   @id @default(cuid())
  threadId    String
  userId      String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  thread      DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       ReplyLike[]

  @@index([threadId])
  @@index([userId])
}

model ThreadLike {
  id          String   @id @default(cuid())
  threadId    String
  userId      String
  createdAt   DateTime @default(now())

  thread      DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
}

model ReplyLike {
  id          String   @id @default(cuid())
  replyId     String
  userId      String
  createdAt   DateTime @default(now())

  reply       DiscussionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
}

model PasswordReset {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // GOOGLE | GITHUB
  providerAccountId String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("general") // general | brand | theme | seo | features
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  type        String   @default("INFO") // INFO | WARNING | MAINTENANCE | PROMOTION
  audience    String   @default("ALL") // ALL | PREMIUM | ADMINS
  isActive    Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
}

model FeaturedContent {
  id          String   @id @default(cuid())
  slot        String   // HERO | CAROUSEL | EDITOR_PICK | SPOTLIGHT
  tmdbId      Int
  mediaType   String   // MOVIE | TV
  title       String
  posterUrl   String?
  backdropUrl String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slot, isActive])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // PAGE_VIEW | SEARCH | MOVIE_VIEW | SIGNUP | LOGIN | RATING | REVIEW | WATCHLIST_ADD
  userId      String?
  tmdbId      Int?
  mediaType   String?
  query       String?
  path        String?
  ip          String?
  userAgent   String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId])
  @@index([createdAt])
}
